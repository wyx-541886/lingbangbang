.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFFCF5 0%, #FDF4E0 50%, #F7E9CC 100%);
}

.points-bar {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #7A6247;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(186, 133, 44, 0.1);
}

.points-val {
  color: #C4882A;
  font-weight: bold;
  font-size: 32rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9A8468;
}

.task-list {
  display: flex;
  flex-direction: column;
}

.task-card {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(186, 133, 44, 0.1);
}

.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A3728;
  flex: 1;
  margin-right: 20rpx;
}

.task-reward {
  background: rgba(196, 136, 42, 0.14);
  color: #C4882A;
  font-size: 26rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.task-desc {
  font-size: 26rpx;
  color: #6B5535;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.task-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-time {
  font-size: 22rpx;
  color: #A08A6E;
}

/* 立体接取按钮 */
.accept-btn {
  background: linear-gradient(170deg, #FCE7B8 0%, #EDBB6A 45%, #D2922F 100%);
  color: #6B4423;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 18rpx rgba(186, 133, 44, 0.32),
              0 3rpx 8rpx rgba(186, 133, 44, 0.18),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.7),
              inset 0 -4rpx 8rpx rgba(148, 98, 18, 0.25);
}

.accept-btn:active {
  box-shadow: 0 3rpx 8rpx rgba(186, 133, 44, 0.25),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.35),
              inset 0 -3rpx 8rpx rgba(148, 98, 18, 0.3);
}

.done-tag {
  font-size: 24rpx;
  color: #9A8468;
  padding: 12rpx 32rpx;
  background: rgba(190, 158, 108, 0.12);
  border-radius: 32rpx;
}
