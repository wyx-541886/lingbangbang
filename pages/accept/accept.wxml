<view class="container">
  <view class="points-bar">
    <text>我的积分：</text>
    <text class="points-val">{{points}}</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{tasks.length === 0}}" class="empty">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂时没有待接取的任务</text>
  </view>

  <!-- 任务列表 -->
  <view class="task-list">
    <view wx:for="{{tasks}}" wx:key="id" class="task-card">
      <view class="task-top">
        <text class="task-title">{{item.title}}</text>
        <view class="task-reward">+{{item.reward}} 积分</view>
      </view>
      <text class="task-desc">{{item.desc}}</text>
      <view class="task-bottom">
        <text class="task-time">{{item.createTime}}</text>
        <view
          wx:if="{{item.status === 'pending'}}"
          class="accept-btn"
          data-id="{{item.id}}"
          bindtap="acceptTask"
        >接取任务</view>
        <view wx:else class="done-tag">已完成</view>
      </view>
    </view>
  </view>

  <!-- 加载动画 -->
  <loading show="{{loading}}" text="{{loadingText}}" />
</view>
