.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFFCF5 0%, #FDF4E0 50%, #F7E9CC 100%);
}

.group {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(186, 133, 44, 0.12);
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  font-size: 30rpx;
  color: #4A3728;
  border-bottom: 1rpx solid rgba(190, 158, 108, 0.18);
}

.cell:last-child {
  border-bottom: none;
}

.cell:active {
  background: rgba(190, 158, 108, 0.1);
}

.arrow {
  color: #A08A6E;
  font-size: 36rpx;
}

.version {
  text-align: center;
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #A08A6E;
}
