.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFFCF5 0%, #FDF4E0 50%, #F7E9CC 100%);
}

.form {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(186, 133, 44, 0.1);
}

.points-bar {
  font-size: 28rpx;
  color: #7A6247;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(190, 158, 108, 0.22);
}

.points-val {
  color: #C4882A;
  font-weight: bold;
  font-size: 32rpx;
}

.field {
  margin-bottom: 36rpx;
}

.label {
  font-size: 28rpx;
  color: #4A3728;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.input {
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(190, 158, 108, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  height: 88rpx;
  box-sizing: border-box;
  color: #4A3728;
}

.textarea {
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(190, 158, 108, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
  color: #4A3728;
}

.reward-options {
  display: flex;
  margin-bottom: 20rpx;
}

.reward-opt {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  margin-right: 16rpx;
  font-size: 30rpx;
  color: #6B5535;
  border: 2rpx solid rgba(190, 158, 108, 0.25);
}

.reward-opt:last-child {
  margin-right: 0;
}

.reward-opt.active {
  background: linear-gradient(170deg, #FCE7B8 0%, #EDBB6A 100%);
  color: #6B4423;
  border-color: #D2922F;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(186, 133, 44, 0.3),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.6);
}

/* 立体提交按钮 */
.submit-btn {
  background: linear-gradient(170deg, #FCE7B8 0%, #EDBB6A 45%, #D2922F 100%);
  color: #6B4423;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 0;
  margin-top: 20rpx;
  box-shadow: 0 14rpx 28rpx rgba(186, 133, 44, 0.35),
              0 5rpx 12rpx rgba(186, 133, 44, 0.2),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.75),
              inset 0 -6rpx 12rpx rgba(148, 98, 18, 0.28);
}

.submit-btn:active {
  box-shadow: 0 5rpx 12rpx rgba(186, 133, 44, 0.28),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.35),
              inset 0 -4rpx 10rpx rgba(148, 98, 18, 0.35);
}
