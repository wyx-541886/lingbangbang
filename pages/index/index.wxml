<view class="container">
  <!-- 瀑布流背景层 -->
  <view class="bg-waterfall {{bgPaused ? 'paused' : ''}}">
    <view class="bg-col col1">
      <view
        wx:for="{{bgTasks[0]}}"
        wx:key="title"
        class="bg-card"
        style="height: {{item.h}}rpx;"
      >
        <text class="bg-card-tag">{{item.tag}}</text>
        <text class="bg-card-title">{{item.title}}</text>
        <view class="bg-card-foot">
          <text class="bg-card-avatar">{{item.avatar}}</text>
          <text class="bg-card-reward">+{{item.reward}}</text>
        </view>
      </view>
    </view>
    <view class="bg-col col2">
      <view
        wx:for="{{bgTasks[1]}}"
        wx:key="title"
        class="bg-card"
        style="height: {{item.h}}rpx;"
      >
        <text class="bg-card-tag">{{item.tag}}</text>
        <text class="bg-card-title">{{item.title}}</text>
        <view class="bg-card-foot">
          <text class="bg-card-avatar">{{item.avatar}}</text>
          <text class="bg-card-reward">+{{item.reward}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 毛玻璃遮罩 -->
  <view class="glass-overlay"></view>

  <!-- 前景内容 -->
  <view class="foreground">
    <!-- 品牌标识 -->
    <view class="brand">
      <view class="brand-logo">邻</view>
      <view class="brand-text">
        <text class="brand-name">邻帮帮</text>
        <text class="brand-sub">邻里互助 · 温暖社区</text>
      </view>
    </view>

    <view class="slogan">
      <text class="slogan-main">发布任务赚积分 · 接取任务攒积分</text>
    </view>

    <!-- 左右大按钮 -->
    <view class="btn-row">
      <view class="btn btn-publish" bindtap="goPublish">
        <view class="btn-icon">发</view>
        <text class="btn-title">发布任务</text>
        <text class="btn-desc">消耗积分</text>
      </view>
      <view class="btn btn-accept" bindtap="goAccept">
        <view class="btn-icon">接</view>
        <text class="btn-title">接取任务</text>
        <text class="btn-desc">获得积分</text>
      </view>
    </view>

    <!-- 积分 -->
    <view class="points-pill">
      <text class="points-label">我的积分</text>
      <text class="points-value">{{points}}</text>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="tabbar">
    <view class="tab-item" bindtap="goMe">
      <text class="tab-icon">👤</text>
      <text class="tab-label">我</text>
    </view>
    <view class="tab-item" bindtap="goSettings">
      <text class="tab-icon">⚙️</text>
      <text class="tab-label">设置</text>
    </view>
  </view>

  <!-- 加载动画 -->
  <loading show="{{loading}}" text="{{loadingText}}" />
</view>
