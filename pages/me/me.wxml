<view class="container">
  <view class="profile-card">
    <view class="avatar">邻</view>
    <view class="profile-info">
      <text class="name">邻帮帮用户</text>
      <text class="uid">社区好邻居</text>
    </view>
  </view>

  <view class="points-card">
    <text class="points-label">我的积分</text>
    <text class="points-value">{{points}}</text>
  </view>

  <view class="stats">
    <view class="stat-item">
      <text class="stat-value">{{publishCount}}</text>
      <text class="stat-label">发布任务</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{acceptCount}}</text>
      <text class="stat-label">接取任务</text>
    </view>
  </view>

  <!-- 加载动画 -->
  <loading show="{{loading}}" text="{{loadingText}}" />
</view>
