.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFFCF5 0%, #FDF4E0 50%, #F7E9CC 100%);
}

.profile-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 24rpx rgba(186, 133, 44, 0.12);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(170deg, #FCE7B8 0%, #EDBB6A 45%, #D2922F 100%);
  color: #6B4423;
  font-size: 56rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 10rpx 22rpx rgba(186, 133, 44, 0.32),
              inset 0 3rpx 0 rgba(255, 255, 255, 0.7),
              inset 0 -6rpx 12rpx rgba(148, 98, 18, 0.25);
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 10rpx;
}

.uid {
  font-size: 26rpx;
  color: #8B7355;
}

.points-card {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 24rpx rgba(186, 133, 44, 0.12);
}

.points-label {
  font-size: 26rpx;
  color: #7A6247;
  margin-bottom: 12rpx;
}

.points-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #C4882A;
}

.stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(190, 158, 108, 0.25);
  border-radius: 24rpx;
  padding: 40rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(186, 133, 44, 0.12);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8B7355;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(190, 158, 108, 0.28);
}
